# Generate a real file with: python3 ops/init_env.py --site-address https://control.example.com --rustdesk-server desk.example.com
POSTGRES_PASSWORD=replace-me
SARMIENTO_DATABASE_URL=postgresql+psycopg://sarmiento:replace-me@db:5432/sarmiento
SARMIENTO_ENVIRONMENT=production
SARMIENTO_OWNER_USERNAME=owner
SARMIENTO_OWNER_PASSWORD=replace-with-at-least-12-characters
SARMIENTO_SESSION_SECRET=replace-with-at-least-32-random-bytes
SARMIENTO_TOKEN_PEPPER=replace-with-an-independent-random-secret
SARMIENTO_SITE_ADDRESS=https://control.example.com
SARMIENTO_PUBLIC_BASE_URL=https://control.example.com
SARMIENTO_COOKIE_SECURE=true
SARMIENTO_ALLOWED_ORIGINS=https://control.example.com
SARMIENTO_ALLOWED_HOSTS=control.example.com,localhost,127.0.0.1
SARMIENTO_RUSTDESK_SERVER=desk.example.com
