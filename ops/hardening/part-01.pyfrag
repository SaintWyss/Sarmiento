s = replace_once(
    s,
    "connect.addEventListener('click',()=>setTimeout(()=>toast(`Si RustDesk no abrió, copiá el ID ${d.rustdesk_id}`),700));",
    "connect.addEventListener('click',()=>{navigator.clipboard?.writeText(d.rustdesk_id).catch(()=>{});setTimeout(()=>toast(`ID ${d.rustdesk_id} copiado como respaldo`),700)});",
    label="connect fallback copy",
)
s = replace_once(
    s,
    "$('rotateTokenButton').onclick=async()=>{if(!confirm('La credencial anterior dejará de funcionar. Tendrás que actualizarla en el agente. ¿Continuar?'))return;try{const id=$('editDeviceId').value;const result=await api(`/devices/${id}/rotate-token`,{method:'POST'});await navigator.clipboard.writeText(result.agent_token);toast('Nueva credencial copiada al portapapeles')}catch(err){$('editError').textContent=err.message}};",
    "$('rotateTokenButton').onclick=async()=>{if(!confirm('El agente renovará su credencial automáticamente en el próximo heartbeat. ¿Continuar?'))return;try{const id=$('editDeviceId').value;await api(`/devices/${id}/rotate-token`,{method:'POST'});$('editDialog').close();await Promise.all([loadDevices(),loadAudit()]);toast('Rotación solicitada al agente')}catch(err){$('editError').textContent=err.message}};",
    label="frontend automatic rotation",
)
write(path, s)

path = "front/sw.js"
s = read(path)
s = replace_once(s, "const CACHE='sarmiento-v1'", "const CACHE='sarmiento-v2'", label="PWA cache")
write(path, s)

# README and security docs
path = "README.md"
s = read(path)
s = replace_once(
    s,
    "- Administración de alias, etiquetas, revocación y rotación de credenciales.",
    "- Administración de alias, etiquetas, revocación y rotación automática de credenciales durante el heartbeat.",
    label="README rotation",
)
write(path, s)

path = "docs/SECURITY.md"
s = read(path)
append = '''\n## Rotación de credenciales del agente\n\nEl propietario solicita la rotación desde el panel. El agente autenticado recibe la señal en el siguiente heartbeat, intercambia su credencial por una nueva y la persiste localmente con permisos restringidos. La credencial anterior deja de ser válida únicamente después de que el agente recibe y guarda la nueva.\n'''
if "## Rotación de credenciales del agente" in s:
    raise RuntimeError("security rotation section already exists")
s += append
write(path, s)

# Migration
write(
    "control-plane/migrations/versions/20260712_0002_agent_rotation.py",
    '''"""Add automatic agent credential rotation state.\n\nRevision ID: 20260712_0002\nRevises: 20260712_0001\nCreate Date: 2026-07-12\n"""\nfrom collections.abc import Sequence\n\nimport sqlalchemy as sa\nfrom alembic import op\n\nrevision: str = "20260712_0002"\ndown_revision: str | None = "20260712_0001"\nbranch_labels: str | Sequence[str] | None = None\ndepends_on: str | Sequence[str] | None = None\n\n\ndef upgrade() -> None:\n    op.add_column(\n        "devices",\n        sa.Column("credential_rotation_requested_at", sa.DateTime(timezone=True), nullable=True),\n    )\n    op.add_column(\n        "devices", sa.Column("credential_rotation_nonce", sa.String(64), nullable=True)\n    )\n    op.add_column(\n        "devices", sa.Column("pending_token_hash", sa.String(64), nullable=True)\n    )\n    op.create_index(\n        "ix_devices_pending_token_hash", "devices", ["pending_token_hash"], unique=True\n    )\n\n\ndef downgrade() -> None:\n    op.drop_index("ix_devices_pending_token_hash", table_name="devices")\n    op.drop_column("devices", "pending_token_hash")\n    op.drop_column("devices", "credential_rotation_nonce")\n    op.drop_column("devices", "credential_rotation_requested_at")\n''',
)

# API tests
path = "control-plane/tests/test_api.py"
s = read(path)
s = replace_once(
    s,
    '''        rotated = client.post(\n            f"/api/v1/devices/{device_id}/rotate-token", headers=csrf_headers(client)\n        )\n        assert rotated.status_code == 200\n        assert rotated.json()["agent_token"].startswith("sat_")\n\n        old_heartbeat = client.post(\n            "/api/v1/agents/heartbeat",\n            headers={"Authorization": f"Bearer {enrollment['agent_token']}"},\n            json={"rustdesk_id": "123456789"},\n        )\n        assert old_heartbeat.status_code == 401\n''',
    '''        rotated = client.post(\n            f"/api/v1/devices/{device_id}/rotate-token", headers=csrf_headers(client)\n        )\n        assert rotated.status_code == 200\n        assert rotated.json()["credential_rotation_pending"] is True\n\n        old_heartbeat = client.post(\n            "/api/v1/agents/heartbeat",\n            headers={"Authorization": f"Bearer {enrollment['agent_token']}"},\n            json={"rustdesk_id": "123456789"},\n        )\n        assert old_heartbeat.status_code == 200\n        assert old_heartbeat.json()["credential_rotation_required"] is True\n''',
    label="existing device management test rotation",
)
s = replace_once(
    s,
    '''        assert "device.credential_rotated" in actions\n        assert "device.revoked" in actions\n''',
    '''        assert "device.credential_rotation_requested" in actions\n        assert "device.revoked" in actions\n''',
    label="existing audit action",
)
s += '''\n\ndef test_agent_credential_rotation_is_applied_automatically(tmp_path):\n    with make_client(tmp_path) as client:\n        login(client)\n        enrollment = enroll(client, issue_enrollment(client))\n        device_id = enrollment["device_id"]\n        old_token = enrollment["agent_token"]\n\n        requested = client.post(\n            f"/api/v1/devices/{device_id}/rotate-token",\n            headers=csrf_headers(client),\n        )\n        assert requested.status_code == 200, requested.text\n        assert requested.json()["credential_rotation_pending"] is True\n\n        heartbeat = client.post(\n            "/api/v1/agents/heartbeat",\n            headers={"Authorization": f"Bearer {old_token}"},\n            json={"rustdesk_id": "123456789"},\n        )\n        assert heartbeat.status_code == 200, heartbeat.text\n        assert heartbeat.json()["credential_rotation_required"] is True\n\n        rotated = client.post(\n            "/api/v1/agents/rotate-token",\n            headers={"Authorization": f"Bearer {old_token}"},\n        )\n        assert rotated.status_code == 200, rotated.text\n        new_token = rotated.json()["agent_token"]\n        assert new_token.startswith("sat_")\n        assert new_token != old_token\n\n        repeated = client.post(\n            "/api/v1/agents/rotate-token",\n            headers={"Authorization": f"Bearer {old_token}"},\n        )\n        assert repeated.status_code == 200\n        assert repeated.json()["agent_token"] == new_token\n\n        old_heartbeat = client.post(\n            "/api/v1/agents/heartbeat",\n            headers={"Authorization": f"Bearer {old_token}"},\n            json={"rustdesk_id": "123456789"},\n        )\n        assert old_heartbeat.status_code == 200\n        assert old_heartbeat.json()["credential_rotation_required"] is True\n\n        new_heartbeat = client.post(\n            "/api/v1/agents/heartbeat",\n            headers={"Authorization": f"Bearer {new_token}"},\n            json={"rustdesk_id": "123456789"},\n        )\n        assert new_heartbeat.status_code == 200\n        assert new_heartbeat.json()["credential_rotation_required"] is False\n\n        stale_heartbeat = client.post(\n            "/api/v1/agents/heartbeat",\n            headers={"Authorization": f"Bearer {old_token}"},\n            json={"rustdesk_id": "123456789"},\n        )\n        assert stale_heartbeat.status_code == 401\n\n        device = client.get(f"/api/v1/devices/{device_id}")\n        assert device.json()["credential_rotation_pending"] is False\n\n        actions = {event["action"] for event in client.get("/api/v1/audit").json()}\n        assert "device.credential_rotation_requested" in actions\n        assert "device.credential_rotation_issued" in actions\n        assert "device.credential_rotated" in actions\n'''
write(path, s)

# Security test for row locking
path = "control-plane/tests/test_security.py"
s = read(path)
s += '''\n\ndef test_enrollment_token_consumption_uses_postgres_row_lock():\n    from sqlalchemy.dialects import postgresql\n\n    from sarmiento.services import enrollment_token_for_update_statement\n\n    statement = enrollment_token_for_update_statement("digest")\n    compiled = str(statement.compile(dialect=postgresql.dialect()))\n    assert "FOR UPDATE" in compiled\n'''
write(path, s)
