# Agent Python
path = "agent/sarmiento_agent.py"
s = read(path)
s = replace_once(
    s,
    '''def heartbeat_once(config_path: Path) -> None:\n    config = load_config(config_path)\n    request_json(\n        f"{config['base_url']}/api/v1/agents/heartbeat",\n        method="POST",\n        body=payload(config["rustdesk_id"]),\n        token=config["agent_token"],\n    )\n''',
    '''def heartbeat_once(config_path: Path) -> None:\n    config = load_config(config_path)\n    response = request_json(\n        f"{config['base_url']}/api/v1/agents/heartbeat",\n        method="POST",\n        body=payload(config["rustdesk_id"]),\n        token=config["agent_token"],\n    )\n    if response.get("credential_rotation_required"):\n        rotated = request_json(\n            f"{config['base_url']}/api/v1/agents/rotate-token",\n            method="POST",\n            token=config["agent_token"],\n        )\n        config["agent_token"] = rotated["agent_token"]\n        save_config(config_path, config)\n        log("Agent credential rotated automatically")\n''',
    label="python agent auto rotation",
)
write(path, s)

# PowerShell agent
path = "agent/sarmiento-agent.ps1"
s = read(path)
s = replace_once(
    s,
    '''function Send-Heartbeat {\n  $config=Read-AgentConfig\n  $headers=@{ Authorization="Bearer $($config.agent_token)" }\n  $body=(Get-HeartbeatBody $config.rustdesk_id) | ConvertTo-Json -Depth 6\n  Invoke-RestMethod -Method Post -Uri "$($config.base_url)/api/v1/agents/heartbeat" -Headers $headers -ContentType 'application/json' -Body $body | Out-Null\n}\n''',
    '''function Send-Heartbeat {\n  $config=Read-AgentConfig\n  $headers=@{ Authorization="Bearer $($config.agent_token)" }\n  $body=(Get-HeartbeatBody $config.rustdesk_id) | ConvertTo-Json -Depth 6\n  $response=Invoke-RestMethod -Method Post -Uri "$($config.base_url)/api/v1/agents/heartbeat" -Headers $headers -ContentType 'application/json' -Body $body\n  if($response.credential_rotation_required){\n    $rotated=Invoke-RestMethod -Method Post -Uri "$($config.base_url)/api/v1/agents/rotate-token" -Headers $headers -ContentType 'application/json'\n    $config.agent_token=$rotated.agent_token\n    Write-AgentConfig $config\n    Write-AgentLog 'Agent credential rotated automatically'\n  }\n}\n''',
    label="powershell agent auto rotation",
)
write(path, s)

# Windows installer security
path = "agent/install-windows.ps1"
s = read(path)
s = replace_once(
    s,
    '''  $base="$env:ProgramData\\Sarmiento"\n  New-Item -ItemType Directory -Force $base | Out-Null\n''',
    '''  $base="$env:ProgramData\\Sarmiento"\n  New-Item -ItemType Directory -Force $base | Out-Null\n  & icacls.exe $base /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' | Out-Null\n  if($LASTEXITCODE -ne 0){ throw 'Could not secure the Sarmiento agent directory ACL.' }\n''',
    label="windows agent ACL",
)
s = replace_once(
    s,
    '''  if(!$PermanentPassword){\n    $chars='abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789'.ToCharArray()\n    $PermanentPassword=-join (1..18 | ForEach-Object { $chars | Get-Random })\n  }\n''',
    '''  if(!$PermanentPassword){\n    $chars='abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789'.ToCharArray()\n    $bytes=New-Object byte[] 18\n    [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)\n    $PermanentPassword=-join ($bytes | ForEach-Object { $chars[$_ % $chars.Length] })\n  }\n''',
    label="windows CSPRNG password",
)
write(path, s)

