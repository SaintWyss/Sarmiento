    "'device.updated':'Dispositivo actualizado','device.credential_rotation_requested':'Rotación solicitada','device.credential_rotation_issued':'Nueva credencial emitida','device.credential_rotated':'Credencial rotada','device.revoked'",
    label="frontend audit labels",
)
