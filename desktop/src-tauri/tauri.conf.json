{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sarmiento",
  "version": "1.0.0",
  "identifier": "ar.saintwyss.sarmiento",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sarmiento",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Controlá tus equipos, pantallas y sesiones remotas",
    "longDescription": "Aplicación nativa de Sarmiento para coordinar Deskflow, RustDesk y el control-plane privado.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sarmiento"]
      }
    }
  }
}

